{
  "name": "agent-planforge",
  "version": "0.1.0",
  "description": "Planning bootstrap for agentic architecture and task generation",
  "license": "MIT",
  "keywords": [
    "agentic",
    "planning",
    "architecture",
    "task-generation",
    "bootstrap"
  ],
  "scripts": {
    "plan:bootstrap": "node scripts/bootstrap-plan.js --input examples/sample-input.json --outdir out/sample",
    "plan:analyze": "node scripts/analyze-artifacts.js --outdir out/sample",
    "plan:refresh-examples": "node scripts/refresh-example-outputs.js",
    "test": "node tests/bootstrap-plan.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.18.0"
  }
}
