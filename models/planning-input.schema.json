{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanningInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectName",
    "summary",
    "targetUsers",
    "coreFeatures",
    "constraints"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "targetUsers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coreFeatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonFunctionalRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataSensitivity": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "regulated"
      ],
      "default": "low"
    },
    "teamSize": {
      "type": "integer",
      "minimum": 1
    },
    "productionExpectedSoon": {
      "type": "boolean",
      "default": false
    },
    "liveUsers": {
      "type": "boolean",
      "default": false
    },
    "enterpriseRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
