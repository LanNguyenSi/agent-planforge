{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanningInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectName",
    "summary",
    "targetUsers",
    "coreFeatures",
    "constraints"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "targetUsers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coreFeatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonFunctionalRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plannerProfile": {
      "type": "string",
      "enum": [
        "startup",
        "product",
        "enterprise",
        "platform"
      ],
      "default": "product"
    },
    "dataSensitivity": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "regulated"
      ],
      "default": "low"
    },
    "teamSize": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "description": "Team size as number of people"
        },
        {
          "type": "string",
          "enum": ["solo", "small", "medium", "large", "enterprise"],
          "description": "Team size as descriptor"
        }
      ],
      "description": "Team size (number or descriptor: solo/small/medium/large/enterprise)"
    },
    "productionExpectedSoon": {
      "type": "boolean",
      "default": false
    },
    "liveUsers": {
      "type": "boolean",
      "default": false
    },
    "enterpriseRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultBranch": {
      "type": "string",
      "description": "Default Git branch name (main, master, etc.). Auto-detected if not specified.",
      "default": "main"
    }
  }
}
