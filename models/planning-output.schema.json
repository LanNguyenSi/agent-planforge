{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanningOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectName",
    "plannerProfile",
    "intakeCompleteness",
    "missingInformation",
    "intakeQuestions",
    "followUpQuestions",
    "phase",
    "phaseRationale",
    "path",
    "recommendedPlaybooks",
    "recommendedGuidanceAreas",
    "recommendedArtifacts",
    "architectureOptions",
    "architectureRecommendation",
    "adrCandidates",
    "tasks",
    "executionWaves",
    "dependencyGraph",
    "promptExports",
    "handoffManifest",
    "risks",
    "openQuestions"
  ],
  "properties": {
    "projectName": {
      "type": "string"
    },
    "plannerProfile": {
      "type": "string",
      "enum": [
        "startup",
        "product",
        "enterprise",
        "platform"
      ]
    },
    "intakeCompleteness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "insufficient"
      ]
    },
    "missingInformation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intakeQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "question",
          "reason",
          "affects",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "question": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "followUpQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase": {
      "type": "string",
      "enum": [
        "phase_0",
        "phase_1",
        "phase_2",
        "phase_3"
      ]
    },
    "phaseRationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path": {
      "type": "string",
      "enum": [
        "core",
        "enterprise"
      ]
    },
    "recommendedPlaybooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendedGuidanceAreas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendedArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architectureOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "shape",
          "summary",
          "scores",
          "strengths",
          "tradeoffs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shape": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deliverySpeed",
              "operationalSimplicity",
              "scalabilityHeadroom",
              "governanceFit"
            ],
            "properties": {
              "deliverySpeed": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "operationalSimplicity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "scalabilityHeadroom": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "governanceFit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "architectureRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionId",
        "shape",
        "summary",
        "reasons"
      ],
      "properties": {
        "optionId": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "adrCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "priority",
          "summary",
          "problem",
          "solution",
          "files",
          "acceptanceCriteria",
          "implementationNotes",
          "wave",
          "dependsOn"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "summary": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementationNotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wave": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliveryPhase": {
            "type": "string",
            "enum": [
              "foundation",
              "implementation",
              "hardening",
              "launch"
            ]
          }
        }
      }
    },
    "executionWaves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "taskIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dependencyGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edges",
        "criticalPathTaskIds"
      ],
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "reason"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "criticalPathTaskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "promptExports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "purpose",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "handoffManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "summary",
        "coordinationStrategy",
        "recommendedArchitectureOptionId",
        "recommendedArchitectureShape",
        "sharedContext",
        "sharedArtifacts",
        "steps"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "coordinationStrategy": {
          "type": "string"
        },
        "recommendedArchitectureOptionId": {
          "type": "string"
        },
        "recommendedArchitectureShape": {
          "type": "string"
        },
        "sharedContext": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "path",
            "plannerProfile",
            "intakeCompleteness"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "enum": [
                "phase_0",
                "phase_1",
                "phase_2",
                "phase_3"
              ]
            },
            "path": {
              "type": "string",
              "enum": [
                "core",
                "enterprise"
              ]
            },
            "plannerProfile": {
              "type": "string",
              "enum": [
                "startup",
                "product",
                "enterprise",
                "platform"
              ]
            },
            "intakeCompleteness": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "insufficient"
              ]
            }
          }
        },
        "sharedArtifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "objective",
              "executionMode",
              "dependsOn",
              "parallelGroup",
              "agentAssignments"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "objective": {
                "type": "string"
              },
              "executionMode": {
                "type": "string",
                "enum": [
                  "sequential",
                  "parallel"
                ]
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "parallelGroup": {
                "type": "string"
              },
              "agentAssignments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "role",
                    "promptExportId",
                    "promptPath",
                    "reads",
                    "writes",
                    "successCriteria"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "promptExportId": {
                      "type": "string"
                    },
                    "promptPath": {
                      "type": "string"
                    },
                    "reads": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "writes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "successCriteria": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
